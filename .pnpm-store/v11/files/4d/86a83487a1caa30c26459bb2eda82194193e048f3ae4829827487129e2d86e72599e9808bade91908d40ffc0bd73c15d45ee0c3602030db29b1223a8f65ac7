{
  "name": "nuxt-site-config-kit",
  "type": "module",
  "version": "4.2.3",
  "description": "Shared site configuration build-time utilities for Nuxt 3 modules.",
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/harlan-zw/nuxt-site-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-site-config.git",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-site-config/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./urls": {
      "import": "./dist/urls.mjs",
      "require": "./dist/urls.cjs"
    },
    "./util": {
      "import": "./dist/util.mjs",
      "require": "./dist/util.cjs"
    },
    "./dist/urls": {
      "import": "./dist/urls.mjs",
      "require": "./dist/urls.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "urls.d.ts",
    "util.d.ts"
  ],
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "std-env": "^4.2.0",
    "ufo": "^1.6.4",
    "site-config-stack": "4.2.3"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.5.2",
    "unbuild": "^3.6.1"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack"
  }
}