		name: ruleName,
		description: "Limit the number of adjacent empty lines in value lists",
		meta: {
			defaultOptions: [0],
			schema: [{ type: "number" }]
		},
		create(context) {
			const { sourceCode } = context;
			const [maximum] = context.options;
			const text = sourceCode.text;
			const newline = newlineFor(text);
			function checkValue(scope) {
				const source = text.slice(scope.start, scope.end);
				const firstContent = source.length - source.trimStart().length;
				const lastContentEnd = source.trimEnd().length;
				let replacement = "";
				let cursor = 0;
				let changed = false;
				for (const match of source.matchAll(LINEBREAK_RUN_RE)) {
					replacement += source.slice(cursor, match.index);
					cursor = match.index + match[0].length;
					if (match.index <= firstContent || cursor >= lastContentEnd) {
						replacement += match[0];
						continue;
					}
					const lineBreaks = match[0].match(LINEBREAK_RE)?.length ?? 0;
					const permittedLineBreaks = maximum + 1;
					if (lineBreaks <= permittedLineBreaks) {
						replacement += match[0];
						continue;
					}
					changed = true;
					replacement += newline.repeat(permittedLineBreaks);
				}
				if (!changed) return;
				replacement += source.slice(cursor);
				context.report({
					loc: {
						start: sourceCode.getLocFromIndex(scope.start),
						end: sourceCode.getLocFromIndex(scope.end)
					},
					messageId: "expected",
					data: { detail: `Expected no more than ${maximum} empty line(s) in value lists.` },
					fix: (fixer) => fixer.replaceTextRange([scope.start, scope.end], replacement)
				});
			}
			return {
				"Block > Declaration > Raw": (node) => {
					const [start, end] = sourceCode.getRange(node);
					checkValue({
						end,
						start
					});
				},
				"Block > Declaration > Value": (node) => {
					const [start, end] = sourceCode.getRange(node);
					checkValue({
						end,
						start
					});
				}
